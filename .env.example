ADMIN_USERNAME=manager
ADMIN_PASSWORD=change-me
SESSION_SECRET=generate-a-long-random-string

# Set these in Netlify → Site configuration → Environment variables
# so workshop login works on the live site.

GARAGE_EMAIL=bookings@banksidemot.co.uk

# Optional. Without this, bookings still save and appear on the calendar,
# but no email is sent. Use the garage's mailbox SMTP (Microsoft 365, Google, etc).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Bankside MOT & Repair <bookings@banksidemot.co.uk>
