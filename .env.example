ADMIN_USERNAME=manager
ADMIN_PASSWORD=change-me
SESSION_SECRET=generate-a-long-random-string

# Set these in Netlify → Site configuration → Environment variables
# so workshop login works on the live site.

GARAGE_EMAIL=bookings@banksidemot.co.uk

# Optional. Without this, bookings still save and appear on the calendar,
# but no email is sent. Use the garage's mailbox SMTP (Microsoft 365, Google, etc).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Bankside MOT & Repair <bookings@banksidemot.co.uk>

# Optional. Public IDs are safe in the browser. Leave blank until Google
# Analytics / Ads are set up — the site still works without them.
# Set these in Netlify too. Conversion labels come from Google Ads
# (Tools → Conversions) after you create Phone click and Booking actions.
PUBLIC_GA_MEASUREMENT_ID=
PUBLIC_GOOGLE_ADS_ID=
PUBLIC_GOOGLE_ADS_BOOKING_LABEL=
PUBLIC_GOOGLE_ADS_PHONE_LABEL=
