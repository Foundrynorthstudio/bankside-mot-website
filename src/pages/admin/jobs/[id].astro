---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getCustomer, listCustomerVehicles } from '../../../lib/booking/customers';
import { getJob, JOB_PAYMENT_METHODS, jobSummary, parseJobForm, recordJobPayment, updateJob, validateJobFields } from '../../../lib/booking/jobs';
import { formatPounds, penceToPoundsInput } from '../../../lib/booking/money';

const { id } = Astro.params;
const url = Astro.url;
let notice = url.searchParams.get('notice') || '';
let error = url.searchParams.get('error') || '';

if (!id) {
  return Astro.redirect('/admin/customers');
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');
  const returnTo = (extra: Record<string, string>) => {
    const next = new URL(`/admin/jobs/${id}`, url.origin);
    for (const [key, value] of Object.entries(extra)) {
      if (value) next.searchParams.set(key, value);
    }
    return Astro.redirect(`${next.pathname}${next.search}`);
  };

  if (action === 'update') {
    const fields = parseJobForm(form);
    const invalid = validateJobFields(fields);
    if (invalid) return returnTo({ error: invalid });
    const updated = updateJob(id, fields);
    if (!updated) return returnTo({ error: 'Could not update this job.' });
    return returnTo({ notice: 'Job details updated.' });
  }

  if (action === 'pay') {
    const paid = recordJobPayment(id, String(form.get('amount') ?? ''), String(form.get('payment_method') ?? ''));
    if (!paid) return returnTo({ error: 'Could not record that payment.' });
    return returnTo({ notice: 'Payment recorded.' });
  }
}

const job = getJob(id);
if (!job) {
  return Astro.redirect('/admin/customers?error=' + encodeURIComponent('Job not found.'));
}

const customer = getCustomer(job.customer_id);
const vehicles = listCustomerVehicles(job.customer_id);
const summary = jobSummary(job);
const currentVehicleMissing = Boolean(job.vehicle_id && !vehicles.some((vehicle) => vehicle.id === job.vehicle_id));

function statusClass(status: string) {
  if (status === 'Paid') return 'bg-emerald-50 text-emerald-800';
  if (status === 'Part paid') return 'bg-amber-50 text-amber-800';
  if (status === 'Unpaid') return 'bg-rose-50 text-rose-800';
  return 'bg-slate-100 text-slate-600';
}
---

<AdminLayout title={`${job.description} | Job`} notice={notice} error={error}>
  <p class="mb-4 text-sm">
    {customer ? (
      <a href={`/admin/customers/${customer.id}`} class="font-semibold text-brand-700 hover:text-brand-800">← {customer.name}</a>
    ) : (
      <a href="/admin/customers" class="font-semibold text-brand-700 hover:text-brand-800">← All customers</a>
    )}
  </p>

  <div class="mx-auto max-w-3xl space-y-6">
    <section class="rounded-2xl border border-slate-200 bg-white p-5">
      <div class="mb-4 flex flex-wrap items-start justify-between gap-3">
        <div>
          <div class="text-[10px] font-semibold tracking-wider text-brand-600 uppercase">Job & invoice</div>
          <h1 class="text-2xl font-extrabold text-slate-900">{job.description}</h1>
          <p class="mt-1 text-sm text-slate-500">
            {job.id}
            {job.invoice_ref && <> · {job.invoice_ref}</>}
            {customer && (
              <>
                {' · '}
                <a href={`/admin/customers/${customer.id}`} class="font-semibold text-brand-700">{customer.name}</a>
              </>
            )}
          </p>
        </div>
        <span class:list={['rounded-full px-2.5 py-1 text-[10px] font-bold uppercase', statusClass(summary.status)]}>
          {summary.status}
        </span>
      </div>

      <dl class="mb-5 grid grid-cols-3 gap-3 rounded-xl border border-slate-100 bg-slate-50 px-4 py-3 text-xs">
        <div>
          <dt class="text-slate-500">Invoiced</dt>
          <dd class="text-sm font-semibold text-slate-900">{formatPounds(job.amount_pence)}</dd>
        </div>
        <div>
          <dt class="text-slate-500">Paid</dt>
          <dd class="text-sm font-semibold text-emerald-700">{formatPounds(job.paid_pence)}</dd>
        </div>
        <div>
          <dt class="text-slate-500">Balance</dt>
          <dd class="text-sm font-semibold text-slate-900">{formatPounds(summary.balance)}</dd>
        </div>
      </dl>

      <form method="post" class="grid gap-3 sm:grid-cols-2">
        <input type="hidden" name="action" value="update" />
        <label class="text-[11px] font-bold tracking-wide text-slate-500 uppercase">
          Date
          <input type="date" name="job_date" required value={job.job_date} class="mt-1 w-full rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm font-normal normal-case tracking-normal text-slate-900" />
        </label>
        <label class="text-[11px] font-bold tracking-wide text-slate-500 uppercase">
          Vehicle
          <select name="vehicle_id" class="mt-1 w-full rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm font-normal normal-case tracking-normal text-slate-900">
            <option value="">No vehicle / general job</option>
            {currentVehicleMissing && (
              <option value={job.vehicle_id} selected>
                {job.vrm}{job.make_model ? ` · ${job.make_model}` : ''} (unlinked)
              </option>
            )}
            {vehicles.map((vehicle) => (
              <option value={vehicle.id} selected={vehicle.id === job.vehicle_id}>
                {vehicle.vrm}{vehicle.make_model ? ` · ${vehicle.make_model}` : ''}
              </option>
            ))}
          </select>
        </label>
        <label class="text-[11px] font-bold tracking-wide text-slate-500 uppercase sm:col-span-2">
          What was done
          <input name="description" required value={job.description} class="mt-1 w-full rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm font-normal normal-case tracking-normal text-slate-900" />
        </label>
        <label class="text-[11px] font-bold tracking-wide text-slate-500 uppercase">
          Invoice ref
          <input name="invoice_ref" value={job.invoice_ref} class="mt-1 w-full rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm font-normal normal-case tracking-normal text-slate-900" />
        </label>
        <label class="text-[11px] font-bold tracking-wide text-slate-500 uppercase">
          Amount £
          <input name="amount" type="number" min="0" step="0.01" value={penceToPoundsInput(job.amount_pence)} class="mt-1 w-full rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm font-normal normal-case tracking-normal text-slate-900" />
        </label>
        <label class="text-[11px] font-bold tracking-wide text-slate-500 uppercase">
          Paid £
          <input name="paid" type="number" min="0" step="0.01" value={penceToPoundsInput(job.paid_pence)} class="mt-1 w-full rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm font-normal normal-case tracking-normal text-slate-900" />
        </label>
        <label class="text-[11px] font-bold tracking-wide text-slate-500 uppercase">
          Payment method
          <select name="payment_method" class="mt-1 w-full rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm font-normal normal-case tracking-normal text-slate-900">
            <option value="">Not recorded</option>
            {JOB_PAYMENT_METHODS.map((method) => (
              <option value={method} selected={method === job.payment_method}>{method}</option>
            ))}
          </select>
        </label>
        <label class="text-[11px] font-bold tracking-wide text-slate-500 uppercase sm:col-span-2">
          Job notes
          <textarea name="job_notes" rows="3" class="mt-1 w-full rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm font-normal normal-case tracking-normal text-slate-900">{job.notes}</textarea>
        </label>
        <div class="sm:col-span-2">
          <button class="rounded-xl bg-slate-900 px-4 py-2.5 text-xs font-semibold text-white">Save changes</button>
        </div>
      </form>
    </section>

    {summary.balance > 0 && (
      <section class="rounded-2xl border border-slate-200 bg-white p-5">
        <h2 class="text-lg font-bold text-slate-900">Record a payment</h2>
        <p class="mt-1 text-xs text-slate-500">Adds to the amount already paid. To correct a mistake, change Paid £ above and save.</p>
        <form method="post" class="mt-4 flex flex-wrap items-end gap-2">
          <input type="hidden" name="action" value="pay" />
          <label class="text-[11px] font-bold tracking-wide text-slate-500 uppercase">
            Amount £
            <input name="amount" type="number" min="0.01" step="0.01" required placeholder="0.00" class="mt-1 w-28 rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm font-normal normal-case tracking-normal text-slate-900" />
          </label>
          <label class="text-[11px] font-bold tracking-wide text-slate-500 uppercase">
            Method
            <select name="payment_method" class="mt-1 rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm font-normal normal-case tracking-normal text-slate-900">
              {JOB_PAYMENT_METHODS.map((method) => (
                <option value={method} selected={method === (job.payment_method || 'Cash')}>{method}</option>
              ))}
            </select>
          </label>
          <button class="rounded-xl bg-brand-600 px-4 py-2.5 text-xs font-semibold text-white">Add payment</button>
        </form>
      </section>
    )}
  </div>
</AdminLayout>
