---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import {
  EMAIL_TEMPLATE_FIELDS,
  listEmailTemplates,
  saveEmailTemplate,
  type EmailTemplateId,
} from '../../lib/booking/email-templates';

const url = Astro.url;
let notice = url.searchParams.get('notice') || '';
let error = url.searchParams.get('error') || '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const saved = await saveEmailTemplate({
    id: String(form.get('id') ?? ''),
    subject: String(form.get('subject') ?? ''),
    body: String(form.get('body') ?? ''),
  });
  const next = new URL('/admin/emails', url.origin);
  if (saved.error || !saved.template) {
    next.searchParams.set('error', saved.error || 'Could not save that email.');
  } else {
    next.searchParams.set('notice', `Saved ${saved.template.name}.`);
  }
  return Astro.redirect(`${next.pathname}${next.search}`);
}

const templates = await listEmailTemplates();

const fieldHelp: Record<EmailTemplateId, string> = {
  customer_booking: 'Sent to the customer after they book online, or after staff save a booking with an email address.',
  garage_booking: 'Sent to hello@banksidemot.com whenever a booking is saved.',
  callback: 'Sent to the garage when someone uses the website callback form.',
};
---

<AdminLayout title="Emails | Bankside MOT & Repair" notice={notice} error={error}>
  <div class="mb-5">
    <h1 class="text-2xl font-extrabold text-slate-900">Automated emails</h1>
    <p class="text-sm text-slate-500">
      Edit the subject and body of the messages the website sends. Use merge fields like
      <code class="font-mono text-xs">{'{{customer_name}}'}</code> — they are filled in when the email goes out.
      From and To addresses stay in the server settings.
    </p>
  </div>

  <div class="grid gap-6">
    {templates.map((template) => (
      <section class="rounded-2xl border border-slate-200 bg-white p-5">
        <div class="mb-4">
          <h2 class="text-lg font-bold text-slate-900">{template.name}</h2>
          <p class="text-sm text-slate-500">{fieldHelp[template.id]}</p>
        </div>
        <form method="post" class="grid gap-4">
          <input type="hidden" name="id" value={template.id} />
          <label class="grid gap-1 text-sm font-semibold text-slate-700">
            Subject
            <input
              name="subject"
              required
              value={template.subject}
              class="rounded-xl border border-slate-200 px-3 py-2 font-normal text-slate-900"
            />
          </label>
          <label class="grid gap-1 text-sm font-semibold text-slate-700">
            Body
            <textarea
              name="body"
              required
              rows="12"
              class="rounded-xl border border-slate-200 px-3 py-2 font-mono text-xs font-normal leading-5 text-slate-900"
            >{template.body}</textarea>
          </label>
          <p class="text-xs leading-5 text-slate-500">
            Merge fields:
            {EMAIL_TEMPLATE_FIELDS[template.id].map((field) => (
              <code class="mr-1 font-mono">{`{{${field}}}`}</code>
            ))}
          </p>
          <div>
            <button type="submit" class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white">
              Save {template.name.toLowerCase()}
            </button>
          </div>
        </form>
      </section>
    ))}
  </div>
</AdminLayout>
