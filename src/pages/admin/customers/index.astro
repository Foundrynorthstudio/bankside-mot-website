---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { createCustomer, searchCustomers } from '../../../lib/booking/customers';
import { normalisePhone, normaliseVrm } from '../../../lib/booking/validate';

const url = Astro.url;
const q = url.searchParams.get('q') ?? '';
let notice = url.searchParams.get('notice') || '';
let error = url.searchParams.get('error') || '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const name = String(form.get('name') ?? '').trim();
  const phone = normalisePhone(String(form.get('phone') ?? ''));
  const email = String(form.get('email') ?? '').trim().toLowerCase();
  const vrm = normaliseVrm(String(form.get('vrm') ?? ''));

  if (name.length < 2 || phone.length < 10) {
    error = 'Name and a valid phone number are required.';
  } else {
    const customer = createCustomer({ name, phone, email, vrm: vrm || undefined });
    return Astro.redirect(`/admin/customers/${customer.id}?notice=${encodeURIComponent('Customer saved.')}`);
  }
}

const customers = searchCustomers(q);
---

<AdminLayout title="Customers | Bankside MOT & Repair" notice={notice} error={error}>
  <div class="mb-5 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h1 class="text-2xl font-extrabold text-slate-900">Customer CRM</h1>
      <p class="text-sm text-slate-500">Search by name, registration, phone or email. Click a row to open the record.</p>
    </div>
    <form method="get" class="flex w-full max-w-md gap-2">
      <input
        type="search"
        name="q"
        value={q}
        placeholder="Name, SK19 MOT, 07700…"
        class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm outline-none focus:border-brand-500"
      />
      <button class="rounded-xl bg-slate-900 px-4 py-2.5 text-xs font-semibold text-white">Search</button>
    </form>
  </div>

  <div class="grid gap-6 lg:grid-cols-12">
    <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white lg:col-span-8">
      {customers.length === 0 ? (
        <p class="p-6 text-sm text-slate-500">{q ? `No customers match “${q}”.` : 'No customers yet. New bookings appear here automatically.'}</p>
      ) : (
        <table class="w-full text-left text-sm">
          <thead class="border-b border-slate-100 bg-slate-50 text-xs font-semibold tracking-wide text-slate-500 uppercase">
            <tr>
              <th class="px-4 py-3">Customer</th>
              <th class="px-4 py-3">Phone</th>
              <th class="px-4 py-3">Vehicles</th>
              <th class="px-4 py-3 text-right">Visits</th>
              <th class="px-4 py-3"><span class="sr-only">Open record</span></th>
            </tr>
          </thead>
          <tbody>
            {customers.map((customer) => (
              <tr class="group border-b border-slate-100 last:border-0 hover:bg-brand-50/60">
                <td class="relative px-4 py-3">
                  <a
                    href={`/admin/customers/${customer.id}`}
                    class="absolute inset-0 z-[1]"
                    aria-label={`Open record for ${customer.name}`}
                  ></a>
                  <div class="font-semibold text-brand-700 group-hover:text-brand-800">{customer.name}</div>
                  {customer.email && <div class="text-xs text-slate-500">{customer.email}</div>}
                </td>
                <td class="relative z-[2] px-4 py-3">
                  <a href={`tel:${customer.phone}`} class="text-slate-700 hover:text-brand-700">{customer.phone}</a>
                </td>
                <td class="relative px-4 py-3 font-medium tracking-wide text-slate-800">
                  <a href={`/admin/customers/${customer.id}`} class="absolute inset-0 z-[1]" tabindex="-1" aria-hidden="true"></a>
                  {customer.vrms || '—'}
                </td>
                <td class="relative px-4 py-3 text-right font-semibold text-slate-900">
                  <a href={`/admin/customers/${customer.id}`} class="absolute inset-0 z-[1]" tabindex="-1" aria-hidden="true"></a>
                  {customer.visit_count}
                </td>
                <td class="relative px-4 py-3 text-right">
                  <a
                    href={`/admin/customers/${customer.id}`}
                    class="relative z-[1] inline-flex items-center gap-1 rounded-lg bg-slate-900 px-3 py-1.5 text-xs font-semibold text-white group-hover:bg-brand-700"
                    tabindex="-1"
                    aria-hidden="true"
                  >
                    Open
                    <i class="fa-solid fa-chevron-right text-[10px]"></i>
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
    </section>

    <section class="rounded-2xl border border-slate-200 bg-white p-5 lg:col-span-4">
      <h2 class="text-lg font-bold text-slate-900">Add customer</h2>
      <p class="mt-1 mb-4 text-xs text-slate-500">Use this for a phone enquiry with no booking yet. Online bookings create a record automatically.</p>
      <form method="post" class="space-y-2">
        <input name="name" required placeholder="Full name" class="w-full rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm" />
        <input name="phone" required placeholder="Phone" class="w-full rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm" />
        <input name="email" type="email" placeholder="Email (optional)" class="w-full rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm" />
        <input name="vrm" placeholder="Registration (optional)" class="w-full rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm uppercase" />
        <button class="w-full rounded-xl bg-brand-600 py-2.5 text-xs font-semibold text-white">Save customer</button>
      </form>
    </section>
  </div>
</AdminLayout>
