---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
---

<Layout
  title="0% MOT Repair Finance Falkirk | Bankside MOT & Repair"
  description="Spread MOT repairs in Falkirk over 4 months at 0% interest. Pay 25% on completion and the rest in 3 equal monthly payments."
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: '0% Payment Assist', path: '/finance' },
  ]}
>
  <div class="py-12 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto bg-slate-50 rounded-3xl p-6 sm:p-10 border border-slate-200 shadow-sm relative overflow-hidden">
        <div class="grid md:grid-cols-12 gap-8 items-center">
          <div class="md:col-span-6 space-y-4">
            <div class="inline-flex items-center gap-2 text-xs font-semibold text-brand-700 bg-brand-50 px-3 py-1 rounded-full border border-brand-100">
              <i class="fa-solid fa-percent"></i> Payment Assist Options
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 leading-tight">
              Spread Repairs Over 4 Months — <span class="text-brand-600">0% Interest</span>
            </h1>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              Unexpected MOT repair or brake replacement? Pay 25% on completion and spread the balance over 3 equal monthly payments with zero interest and no hidden fees.
            </p>

            <div class="space-y-2 text-xs text-slate-700 font-medium">
              <div class="flex items-center gap-2"><i class="fa-solid fa-check text-brand-600"></i> No interest or hidden admin fees</div>
              <div class="flex items-center gap-2"><i class="fa-solid fa-check text-brand-600"></i> Quick 2-minute card setup</div>
              <div class="flex items-center gap-2"><i class="fa-solid fa-check text-brand-600"></i> Available on repair bills over £100</div>
            </div>
          </div>

          <div class="md:col-span-6 bg-white rounded-2xl p-6 border border-slate-200 space-y-5 shadow-sm">
            <div class="flex justify-between items-center">
              <label class="text-xs font-semibold text-slate-500 uppercase">Estimated Repair Bill:</label>
              <span class="text-2xl font-extrabold text-slate-900">£<span x-text="financeAmount"></span></span>
            </div>

            <input type="range" min="100" max="1200" step="25" x-model="financeAmount" class="w-full accent-brand-600 cursor-pointer" />

            <div class="grid grid-cols-2 gap-3 text-center pt-2">
              <div class="bg-slate-50 p-3 rounded-xl border border-slate-100">
                <div class="text-[10px] uppercase text-slate-500 font-semibold">Pay Today (25%)</div>
                <div class="text-lg font-bold text-brand-600">£<span x-text="(financeAmount * 0.25).toFixed(2)"></span></div>
              </div>
              <div class="bg-slate-50 p-3 rounded-xl border border-slate-100">
                <div class="text-[10px] uppercase text-slate-500 font-semibold">3x Monthly Payments</div>
                <div class="text-lg font-bold text-slate-900">£<span x-text="((financeAmount * 0.75) / 3).toFixed(2)"></span>/mo</div>
              </div>
            </div>

            <button type="button" @click="openBookingModal()" class="w-full py-3 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-semibold text-xs tracking-wide transition">
              Apply Payment Assist at Booking
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
