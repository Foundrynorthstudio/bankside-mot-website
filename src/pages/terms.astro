---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import { business, motRetestGuidanceUrl } from '../data/site';
---

<Layout
  title="Terms & Conditions | Bankside MOT & Repair Falkirk"
  description="Booking terms for MOT tests, servicing and repairs at Bankside MOT & Repair, Castlelaurie Industrial Estate, Falkirk."
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Terms & Conditions', path: '/terms' },
  ]}
>
  <div class="bg-white py-12">
    <div class="container mx-auto max-w-3xl px-4 space-y-6 text-sm leading-relaxed text-slate-600">
      <h1 class="text-3xl font-extrabold text-slate-900">Terms & Conditions</h1>
      <p>These terms cover online and phone bookings with {business.legalName}.</p>
      <h2 class="text-xl font-bold text-slate-900">Bookings</h2>
      <p>
        An online booking reserves a diary slot. Please arrive a few minutes before the time shown. If you cannot attend, call {business.telephoneDisplay} so we can free the slot. Same-day slots may close 30 minutes before the start time.
      </p>
      <h2 class="text-xl font-bold text-slate-900">Prices</h2>
      <p>
        MOT prices are fixed as shown. Servicing prices are “from” figures and can change with vehicle type, engine oil spec, or extra parts. Repair work is quoted and agreed before we start.
      </p>
      <h2 class="text-xl font-bold text-slate-900">MOT tests</h2>
      <p>
        MOT inspections follow DVSA standards. A test result is not a guarantee of future condition. Retests follow DVSA rules: if the vehicle is left with us for repair and retested within 10 working days, the partial retest is free. If it is taken away and returned within 10 working days, a partial retest fee may apply, except that certain items can be retested free of charge if brought back before the end of the next working day. In any other case a full retest and the full fee apply. See the{' '}
        <a href={motRetestGuidanceUrl} class="font-semibold text-brand-700 underline decoration-brand-200 underline-offset-2 hover:text-brand-800" target="_blank" rel="noopener noreferrer">official MOT retest rules on GOV.UK</a>
        . Retest slots are arranged by phone with the office on {business.telephoneDisplay} and cannot be booked online.
      </p>
      <h2 class="text-xl font-bold text-slate-900">Payment</h2>
      <p>
        Pay at the garage unless you apply for 0% Payment Assist on eligible repair bills over £100. Payment Assist is subject to status.
      </p>
    </div>
  </div>
</Layout>
