---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page not found | Bankside MOT & Repair Falkirk"
  description="That page is not on the Bankside MOT & Repair website. Book an MOT, view services, or find the workshop in Falkirk."
  noindex
>
  <div class="flex flex-grow items-center justify-center px-4 py-24">
    <div class="max-w-lg text-center">
      <p class="text-xs font-semibold tracking-wider text-brand-600 uppercase">404</p>
      <h1 class="mt-2 text-3xl font-extrabold text-slate-900">That page is not here</h1>
      <p class="mt-3 text-sm text-slate-600">
        The link may be out of date. You can book a Class 4 or Class 7 MOT, check fixed prices, or get directions to Castlelaurie Industrial Estate.
      </p>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
        <a href="/" class="rounded-xl bg-slate-900 px-4 py-2.5 text-xs font-semibold text-white">Home</a>
        <a href="/services" class="rounded-xl border border-slate-200 px-4 py-2.5 text-xs font-semibold text-slate-800">Services & prices</a>
        <a href="/contact" class="rounded-xl border border-slate-200 px-4 py-2.5 text-xs font-semibold text-slate-800">Contact & map</a>
      </div>
    </div>
  </div>
</Layout>
