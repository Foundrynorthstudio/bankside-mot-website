---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import { business } from '../data/site';
---

<Layout
  title="Book a Class 4 MOT Online Falkirk | Bankside MOT & Repair"
  description="Book a Class 4 MOT in Falkirk online for £50. Choose a weekday 45-minute slot from 8:30am. Or call 01324 613007. Castlelaurie Industrial Estate, FK2 7XJ."
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Book online', path: '/book' },
  ]}
>
  <div class="bg-slate-50 py-12">
    <div class="container mx-auto max-w-2xl px-4">
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
        <span class="rounded-full border border-brand-100 bg-brand-50 px-3 py-1 text-xs font-semibold tracking-wider text-brand-600 uppercase">Online booking</span>
        <h1 class="mt-3 text-3xl font-extrabold text-slate-900">Book a Class 4 MOT in Falkirk</h1>
        <p class="mt-2 text-sm leading-relaxed text-slate-600">
          First MOT tests only — £50, 45-minute slots from 8:30am, last booking 4:00pm. You can also book an MOT with a major service (from £310) as a morning drop-off.
        </p>
        <ul class="mt-5 space-y-2 text-sm text-slate-600">
          <li class="flex items-center gap-2"><i class="fa-solid fa-check text-brand-600"></i> {business.streetAddress}, {business.addressLocality} {business.postalCode}</li>
          <li class="flex items-center gap-2"><i class="fa-solid fa-check text-brand-600"></i> {business.openingHoursDisplay}</li>
          <li class="flex items-center gap-2"><i class="fa-solid fa-check text-brand-600"></i> Saturday {business.saturdayDisplay.toLowerCase()} · Sunday {business.sundayDisplay.toLowerCase()}</li>
        </ul>
        <div class="mt-6 flex flex-col gap-2 sm:flex-row">
          <button type="button" @click="quickBook('Class 4 MOT', 50)" class="flex-1 rounded-xl bg-brand-600 px-4 py-3 text-xs font-semibold text-white transition hover:bg-brand-700">
            Book Class 4 MOT (£50)
          </button>
          <button type="button" @click="quickBook('MOT + Major Service Combo', 310)" class="flex-1 rounded-xl bg-slate-900 px-4 py-3 text-xs font-semibold text-white transition hover:bg-slate-800">
            MOT + major service
          </button>
        </div>
        <a href={`tel:${business.telephone}`} class="mt-3 flex w-full items-center justify-center rounded-xl border border-slate-200 px-4 py-3 text-xs font-semibold text-slate-900 transition hover:bg-slate-50">
          Prefer to talk? Call {business.telephoneDisplay}
        </a>
        <p class="mt-4 text-xs text-slate-500">Retests, servicing, brakes, alignment and air-con are booked by phone so the workshop can fit them into the diary.</p>
      </div>
    </div>
  </div>
</Layout>
