---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import ImageSlot from '../components/ImageSlot.astro';
import { photos } from '../data/photos';
import { team, teamIntro } from '../data/team';
---

<Layout
  title="About the Falkirk MOT Team | Bankside MOT & Repair"
  description="Meet the Bankside MOT & Repair team in Falkirk — decades of workshop experience, DVSA MOT testing, and an office that knows the garage inside out."
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'About Us & Team', path: '/about' },
  ]}
>
  <div class="bg-white py-12">
    <div class="container mx-auto px-4">
      <div class="mb-12 grid items-center gap-10 lg:grid-cols-12">
        <div class="space-y-3 lg:col-span-5">
          <span class="rounded-full border border-brand-100 bg-brand-50 px-3 py-1 text-xs font-semibold tracking-wider text-brand-600 uppercase">Castlelaurie Industrial Estate, Falkirk</span>
          <h1 class="text-3xl font-extrabold text-slate-900 sm:text-4xl">About Bankside MOT & Repair</h1>
          <p class="text-sm leading-relaxed text-slate-600 sm:text-base">
            Bankside MOT & Repair was built to bring fast turnaround times and main dealer diagnostic accuracy to Falkirk drivers at clear, honest rates. Drop the keys at reception if you are heading off — there is a sofa if you would rather wait.
          </p>
        </div>
        <div class="grid grid-cols-2 gap-3 lg:col-span-7">
          <ImageSlot
            src={photos.aboutWorkshop.src}
            label={photos.aboutWorkshop.label}
            brief={photos.aboutWorkshop.brief}
            alt="Engine bay open in the Bankside MOT workshop"
            class="aspect-[4/3] rounded-2xl"
          />
          <ImageSlot
            src={photos.waitingLounge.src}
            label={photos.waitingLounge.label}
            brief={photos.waitingLounge.brief}
            alt="Reception desk and waiting sofa at Bankside MOT & Repair"
            class="aspect-[4/3] rounded-2xl"
          />
        </div>
      </div>

      <div class="mb-16 grid gap-6 md:grid-cols-3">
        <div class="space-y-3 rounded-2xl border border-slate-100 bg-slate-50 p-6 text-center">
          <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-xl border border-brand-100 bg-brand-50 text-xl font-bold text-brand-600">
            <i class="fa-solid fa-award"></i>
          </div>
          <h3 class="text-lg font-bold text-slate-900">DVSA Certified Bay</h3>
          <p class="text-sm leading-relaxed text-slate-600">Fully approved testing bays with high-capacity hydraulic lifts to handle domestic cars, commercial vans, and fleet vehicles.</p>
        </div>

        <div class="space-y-3 rounded-2xl border border-slate-100 bg-slate-50 p-6 text-center">
          <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-xl border border-brand-100 bg-brand-50 text-xl font-bold text-brand-600">
            <i class="fa-solid fa-file-invoice-dollar"></i>
          </div>
          <h3 class="text-lg font-bold text-slate-900">100% Upfront Quotes</h3>
          <p class="text-sm leading-relaxed text-slate-600">No surprise bills. All repair work is quoted and approved by you before a single wrench is turned on your car.</p>
        </div>

        <div class="space-y-3 rounded-2xl border border-slate-100 bg-slate-50 p-6 text-center">
          <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-xl border border-brand-100 bg-brand-50 text-xl font-bold text-brand-600">
            <i class="fa-solid fa-microchip"></i>
          </div>
          <h3 class="text-lg font-bold text-slate-900">OEM Diagnostics</h3>
          <p class="text-sm leading-relaxed text-slate-600">Comprehensive diagnostic scanners for BMW, Audi, VW, Mercedes, Ford, Vauxhall, Toyota, Nissan, and all major vehicle brands.</p>
        </div>
      </div>

      <div class="mb-4">
        <div class="mx-auto mb-10 max-w-2xl text-center">
          <h2 class="text-2xl font-bold text-slate-900">Meet the Bankside team</h2>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">{teamIntro}</p>
        </div>

        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {team.map((member) => (
            <div class="flex flex-col justify-between overflow-hidden rounded-2xl border border-slate-200 bg-white">
              <div class="space-y-3 p-6">
                <div class="flex h-12 w-12 items-center justify-center rounded-xl border border-brand-100 bg-brand-50 text-brand-700">
                  <i class:list={['fa-solid', member.icon]}></i>
                </div>
                <div>
                  <h3 class="font-bold text-slate-900">{member.name}</h3>
                  <div class="text-xs font-semibold text-brand-600">{member.role}</div>
                </div>
                <p class="text-sm leading-relaxed text-slate-600">{member.bio}</p>
              </div>
              <div class="border-t border-slate-100 bg-slate-50 px-6 py-3 text-[11px] font-medium text-slate-600">
                {member.note}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</Layout>
