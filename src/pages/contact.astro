---
import Layout from '../layouts/Layout.astro';
import ImageSlot from '../components/ImageSlot.astro';
import { photos } from '../data/photos';
import { business } from '../data/site';
---

<Layout
  title="MOT Centre Falkirk | Directions to Castlelaurie | Bankside MOT & Repair"
  description="Visit Bankside MOT & Repair at Unit 1b, Castlelaurie Industrial Estate, Falkirk FK2 7XJ. Call 01324 613007. Open Monday to Friday, 8:30am–5:00pm."
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Contact', path: '/contact' },
  ]}
>
  <div class="bg-white py-12">
    <div class="container mx-auto px-4">
      <div class="grid gap-8 lg:grid-cols-12">
        <div class="space-y-6 lg:col-span-5">
          <div>
            <span class="text-xs font-semibold tracking-wider text-brand-600 uppercase">Direct Contact</span>
            <h1 class="mt-1 text-3xl font-extrabold text-slate-900">MOT garage in Falkirk — visit us</h1>
            <p class="mt-1 text-sm text-slate-500">Located at Castlelaurie Industrial Estate, Falkirk.</p>
          </div>

          <ImageSlot
            src={photos.exterior.src}
            label={photos.exterior.label}
            brief={photos.exterior.brief}
            alt={`${business.name}, ${business.streetAddress}`}
            class="aspect-[16/10] rounded-2xl"
          />

          <div class="space-y-3 text-sm text-slate-700">
            <div class="flex items-start gap-3 rounded-xl border border-slate-100 bg-slate-50 p-4">
              <i class="fa-solid fa-location-dot mt-0.5 text-base text-brand-600"></i>
              <div>
                <div class="text-sm font-bold text-slate-900">{business.name}</div>
                <div>{business.streetAddress}</div>
                <div>{business.addressLocality}, {business.postalCode}</div>
              </div>
            </div>

            <div class="flex items-center gap-3 rounded-xl border border-slate-100 bg-slate-50 p-4">
              <i class="fa-solid fa-phone text-base text-brand-600"></i>
              <div>
                <div class="text-sm font-bold text-slate-900">Reception Phone Line</div>
                <a href="tel:01324613007" class="text-sm font-bold text-brand-600 hover:underline">01324 613007</a>
              </div>
            </div>

            <div class="flex items-start gap-3 rounded-xl border border-slate-100 bg-slate-50 p-4">
              <i class="fa-solid fa-clock mt-0.5 text-base text-brand-600"></i>
              <div class="w-full">
                <div class="mb-1 text-sm font-bold text-slate-900">Opening Hours</div>
                <div class="flex justify-between border-b border-slate-200/60 py-0.5">
                  <span>Monday – Friday:</span>
                  <span class="font-semibold text-slate-900">8:30 AM – 5:00 PM</span>
                </div>
                <div class="flex justify-between border-b border-slate-200/60 py-0.5">
                  <span>Saturday:</span>
                  <span class="text-slate-500">By Appointment</span>
                </div>
                <div class="flex justify-between py-0.5">
                  <span>Sunday:</span>
                  <span class="text-slate-500">Closed</span>
                </div>
              </div>
            </div>
          </div>

          <div class="space-y-3 rounded-2xl border border-slate-200 bg-slate-50 p-5">
            <div class="text-xs font-bold text-slate-900 uppercase">Request Mechanic Callback</div>
            <form @submit.prevent="submitContactForm()" class="space-y-2">
              <input type="text" x-model="contactForm.name" placeholder="Your Name" required class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-sm text-slate-900 outline-none focus:border-brand-500" />
              <input type="tel" x-model="contactForm.phone" placeholder="Phone Number" required class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-sm text-slate-900 outline-none focus:border-brand-500" />
              <textarea x-model="contactForm.message" placeholder="Vehicle reg & required repair" rows="2" class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-sm text-slate-900 outline-none focus:border-brand-500"></textarea>
              <button type="submit" class="w-full rounded-lg bg-slate-900 py-2.5 text-xs font-semibold tracking-wide text-white transition hover:bg-slate-800">
                Send Callback Request
              </button>
            </form>
            <div x-show="contactSent" x-cloak class="mt-2 text-center text-xs font-semibold text-emerald-700" x-transition>
              Callback requested! Reception will call you shortly.
            </div>
          </div>
        </div>

        <div class="flex min-h-[400px] flex-col lg:col-span-7">
          <div class="relative flex h-full min-h-[420px] flex-col overflow-hidden rounded-2xl border border-slate-200">
            <iframe
              title={`${business.name} workshop location on Google Maps`}
              class="h-full min-h-[420px] w-full border-0"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              src={business.mapsEmbed}
            ></iframe>
            <a
              href={business.mapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="absolute right-4 bottom-4 flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-900 shadow-sm transition hover:bg-slate-50"
            >
              <i class="fa-solid fa-diamond-turn-right text-brand-600"></i> Open Directions in Google Maps
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
