---
import Layout from '../layouts/Layout.astro';
import ImageSlot from '../components/ImageSlot.astro';
import FaqList from '../components/FaqList.astro';
import { photos } from '../data/photos';
import { serviceFaqs } from '../data/faqs';
---

<Layout
  title="MOT Prices Falkirk | Class 4 £40, Class 7 £50 | Bankside MOT & Repair"
  description="Fixed-price MOT tests in Falkirk: Class 4 MOT £40, Class 7 MOT £50, interim service from £120, major service from £185. VAT included. Book online."
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Services & Pricing', path: '/services' },
  ]}
  faqs={serviceFaqs}
>
  <div class="bg-slate-50 py-12">
    <div class="container mx-auto px-4">
      <div class="mx-auto mb-12 max-w-3xl text-center">
        <span class="rounded-full border border-brand-100 bg-brand-50 px-3 py-1 text-xs font-semibold tracking-wider text-brand-600 uppercase">Transparent Pricing</span>
        <h1 class="mt-2 text-3xl font-extrabold text-slate-900 sm:text-4xl">MOT & garage prices in Falkirk</h1>
        <p class="mt-2 text-sm text-slate-600 sm:text-base">Clear upfront rates with no hidden add-ons. VAT included.</p>
      </div>

      <div class="mb-12 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        <div class="hover-lift flex flex-col justify-between overflow-hidden rounded-2xl border border-slate-200 bg-white">
          <ImageSlot
            src={photos.serviceMot.src}
            label={photos.serviceMot.label}
            brief={photos.serviceMot.brief}
            class="aspect-[16/10] w-full"
          />
          <div class="flex flex-1 flex-col justify-between p-6">
            <div>
              <div class="mb-3 flex items-start justify-between">
                <h3 class="text-xl font-bold text-slate-900">Class 4 MOT Test</h3>
                <span class="rounded-full bg-slate-100 px-2.5 py-1 text-[10px] font-bold text-slate-700 uppercase">Standard Cars</span>
              </div>
              <p class="mb-4 text-sm text-slate-500">Official DVSA inspection for cars, small vans & taxis up to 3,000kg.</p>
              <div class="mb-4 text-3xl font-extrabold text-slate-900">£40<span class="text-xs font-normal text-slate-500">.00 Fixed</span></div>
              <ul class="mb-6 space-y-2 text-sm text-slate-600">
                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-brand-600"></i> Official DVSA Inspection</li>
                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-brand-600"></i> Free 10-Day Retest Policy</li>
                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-brand-600"></i> 45-60 Min Turnaround</li>
                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-brand-600"></i> Clean Waiting Lounge & Wi-Fi</li>
              </ul>
            </div>
            <button type="button" @click="quickBook('Class 4 MOT', 40)" class="w-full rounded-xl bg-brand-600 py-2.5 text-xs font-semibold text-white transition hover:bg-brand-700">
              Book Class 4 (£40)
            </button>
          </div>
        </div>

        <div class="hover-lift flex flex-col justify-between overflow-hidden rounded-2xl border border-slate-200 bg-white">
          <ImageSlot
            src={photos.serviceClass7.src}
            label={photos.serviceClass7.label}
            brief={photos.serviceClass7.brief}
            class="aspect-[16/10] w-full"
          />
          <div class="flex flex-1 flex-col justify-between p-6">
            <div>
              <div class="mb-3 flex items-start justify-between">
                <h3 class="text-xl font-bold text-slate-900">Class 7 MOT Test</h3>
                <span class="rounded-full bg-slate-100 px-2.5 py-1 text-[10px] font-bold text-slate-700 uppercase">Commercial Vans</span>
              </div>
              <p class="mb-4 text-sm text-slate-500">High-bay inspection for commercial goods vehicles (3,000kg – 3,500kg DGW).</p>
              <div class="mb-4 text-3xl font-extrabold text-slate-900">£50<span class="text-xs font-normal text-slate-500">.00 Fixed</span></div>
              <ul class="mb-6 space-y-2 text-sm text-slate-600">
                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-brand-600"></i> Heavy Commercial Bay</li>
                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-brand-600"></i> High Capacity Lift</li>
                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-brand-600"></i> Fleet Account Support</li>
                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-brand-600"></i> Itemized VAT Invoice</li>
              </ul>
            </div>
            <button type="button" @click="quickBook('Class 7 MOT', 50)" class="w-full rounded-xl bg-brand-600 py-2.5 text-xs font-semibold text-white transition hover:bg-brand-700">
              Book Class 7 (£50)
            </button>
          </div>
        </div>

        <div class="hover-lift flex flex-col justify-between overflow-hidden rounded-2xl border border-slate-200 bg-white">
          <ImageSlot
            src={photos.serviceServicing.src}
            label={photos.serviceServicing.label}
            brief={photos.serviceServicing.brief}
            class="aspect-[16/10] w-full"
          />
          <div class="flex flex-1 flex-col justify-between p-6">
            <div>
              <div class="mb-3 flex items-start justify-between">
                <h3 class="text-xl font-bold text-slate-900">Interim Servicing</h3>
                <span class="rounded-full bg-slate-100 px-2.5 py-1 text-[10px] font-bold text-slate-700 uppercase">6,000 Miles Check</span>
              </div>
              <p class="mb-4 text-sm text-slate-500">Essential oil, filter change and multi-point safety inspection.</p>
              <div class="mb-4 text-3xl font-extrabold text-slate-900"><span class="text-xs font-normal text-slate-500">From </span>£120<span class="text-xs font-normal text-slate-500">.00</span></div>
              <ul class="mb-6 space-y-2 text-sm text-slate-600">
                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-brand-600"></i> Synthetic oil replacement</li>
                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-brand-600"></i> OEM oil filter replacement</li>
                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-brand-600"></i> 35-point vehicle health check</li>
                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-brand-600"></i> Service light reset</li>
              </ul>
            </div>
            <button type="button" @click="quickBook('Interim Service', 120)" class="w-full rounded-xl bg-brand-600 py-2.5 text-xs font-semibold text-white transition hover:bg-brand-700">
              Book Interim Service
            </button>
          </div>
        </div>

        <div class="hover-lift flex flex-col justify-between overflow-hidden rounded-2xl border border-slate-200 bg-white">
          <ImageSlot
            src={photos.serviceServicing.src}
            label="Major service"
            brief="Can reuse the servicing shot, or take a wider bay photo during a full annual service."
            class="aspect-[16/10] w-full"
          />
          <div class="flex flex-1 flex-col justify-between p-6">
            <div>
              <div class="mb-3 flex items-start justify-between">
                <h3 class="text-xl font-bold text-slate-900">Major Servicing</h3>
                <span class="rounded-full border border-emerald-100 bg-emerald-50 px-2.5 py-1 text-[10px] font-bold text-emerald-800 uppercase">Annual Check</span>
              </div>
              <p class="mb-4 text-sm text-slate-500">Complete yearly service & full mechanical vehicle health check.</p>
              <div class="mb-4 text-3xl font-extrabold text-slate-900"><span class="text-xs font-normal text-slate-500">From </span>£185<span class="text-xs font-normal text-slate-500">.00</span></div>
              <ul class="mb-6 space-y-2 text-sm text-slate-600">
                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-brand-600"></i> All Interim Service items</li>
                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-brand-600"></i> Air, Fuel & Cabin filters</li>
                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-brand-600"></i> 70-point comprehensive check</li>
                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-brand-600"></i> Spark plug inspection</li>
              </ul>
            </div>
            <button type="button" @click="quickBook('Major Service', 185)" class="w-full rounded-xl bg-brand-600 py-2.5 text-xs font-semibold text-white transition hover:bg-brand-700">
              Book Major Service
            </button>
          </div>
        </div>
      </div>

      <div class="flex flex-col items-center justify-between gap-4 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm md:flex-row">
        <div class="flex items-center gap-4 text-center md:text-left">
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-brand-100 bg-brand-50 text-xl font-bold text-brand-600">
            <i class="fa-solid fa-tag"></i>
          </div>
          <div>
            <h4 class="text-base font-bold text-slate-900">Save £20 when combining MOT + Major Service</h4>
            <p class="text-sm text-slate-500">Combine your annual MOT with any Full or Major Service for maximum convenience and bundle savings.</p>
          </div>
        </div>
        <button type="button" @click="quickBook('MOT + Major Service Combo', 205)" class="whitespace-nowrap rounded-xl bg-slate-900 px-5 py-3 text-xs font-semibold text-white transition hover:bg-slate-800">
          Book MOT & Service Bundle (£205)
        </button>
      </div>

      <FaqList items={serviceFaqs} />
    </div>
  </div>
</Layout>
