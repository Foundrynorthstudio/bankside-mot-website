---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import { serviceTowns } from '../data/areas';
import { business } from '../data/site';
---

<Layout
  title="MOT Falkirk, Grangemouth, Larbert & Polmont | Bankside MOT & Repair"
  description="MOT tests and repairs for Falkirk, Grangemouth, Larbert, Polmont, Stenhousemuir and Denny. Workshop at Castlelaurie Industrial Estate, FK2 7XJ."
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Areas We Serve', path: '/areas' },
  ]}
>
  <div class="bg-white py-12">
    <div class="container mx-auto px-4">
      <div class="mx-auto mb-10 max-w-3xl text-center">
        <span class="rounded-full border border-brand-100 bg-brand-50 px-3 py-1 text-xs font-semibold tracking-wider text-brand-600 uppercase">Stirlingshire local coverage</span>
        <h1 class="mt-2 text-3xl font-extrabold text-slate-900">MOT and repairs for Falkirk and nearby towns</h1>
        <p class="mt-2 text-sm text-slate-600 sm:text-base">
          One workshop at {business.streetAddress}, {business.addressLocality} {business.postalCode}. Class 4 MOT £50, servicing and repairs — book online or call {business.telephoneDisplay}.
        </p>
      </div>

      <div class="mx-auto grid max-w-5xl gap-4 md:grid-cols-2">
        {serviceTowns.map((town) => (
          <article class="rounded-2xl border border-slate-200 bg-slate-50 p-6">
            <div class="flex items-start justify-between gap-3">
              <h2 class="text-xl font-bold text-slate-900">MOT & repairs — {town.name}</h2>
              <span class="shrink-0 rounded-full border border-slate-200 bg-white px-2.5 py-0.5 text-[11px] font-semibold text-slate-500">{town.postcode}</span>
            </div>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{town.description}</p>
            <p class="mt-3 text-xs font-semibold text-slate-700">
              <i class="fa-solid fa-car-side mr-1.5 text-brand-600"></i>
              {town.driveTime} · {town.route}
            </p>
            <div class="mt-4 flex flex-wrap gap-2">
              <a href="/mot-falkirk" class="rounded-xl bg-slate-900 px-3 py-2 text-xs font-semibold text-white transition hover:bg-slate-800">Class 4 MOT £50</a>
              <a href="/book" class="rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-900 transition hover:bg-slate-100">Book online</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</Layout>
