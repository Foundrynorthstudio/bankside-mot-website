---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import ImageSlot from '../components/ImageSlot.astro';
import ReviewSlot from '../components/ReviewSlot.astro';
import { photoExists, photos } from '../data/photos';
import { reviews } from '../data/reviews';
import { business } from '../data/site';

const hasHeroPhoto = photoExists(photos.heroWorkshop.src);
const hasTeamBandPhoto = photoExists(photos.teamBand.src);
---

<Layout>
  <section class="relative overflow-hidden border-b border-slate-900">
    <div class="absolute inset-0">
      <ImageSlot
        src={photos.heroWorkshop.src}
        label={photos.heroWorkshop.label}
        brief={photos.heroWorkshop.brief}
        alt="Bankside MOT & Repair workshop bay in Falkirk"
        eager
        class="h-full w-full"
      />
    </div>
    <div class:list={['absolute inset-0', hasHeroPhoto ? 'bg-gradient-to-r from-slate-950/92 via-slate-950/75 to-slate-950/45' : 'bg-gradient-to-r from-slate-950/80 via-slate-950/55 to-slate-950/30']}></div>

    <div class="container relative z-10 mx-auto px-4 py-14 lg:py-20">
      <div class="grid items-center gap-12 lg:grid-cols-12">
        <div class="space-y-6 text-center lg:col-span-7 lg:text-left">
          <div class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-3.5 py-1.5 text-xs font-semibold text-emerald-200">
            <i class="fa-solid fa-circle-check text-brand-500"></i>
            <span>Independent DVSA-approved MOT &amp; Repair garage in Falkirk</span>
          </div>

          <h1 class="text-4xl font-extrabold leading-[1.1] tracking-tight text-white sm:text-5xl lg:text-6xl">
            MOT Tests, Servicing <br class="hidden sm:inline" />
            <span class="text-brand-500">& Repair in Falkirk</span>
          </h1>

          <p class="mx-auto max-w-2xl text-base font-normal leading-relaxed text-slate-300 sm:text-lg lg:mx-0">
            Independent mechanic expertise with clear pricing. DVSA approved Class 4 MOT tests, dealer-spec vehicle servicing, and diagnostics at Castlelaurie Industrial Estate.
          </p>

          <div class="flex flex-wrap items-center justify-center gap-3 pt-2 text-xs font-medium text-slate-700 lg:justify-start">
            <span class="flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-1.5 shadow-sm"><i class="fa-solid fa-shield-check text-brand-600"></i> Free 10-Day Retest</span>
            <span class="flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-1.5 shadow-sm"><i class="fa-solid fa-clock text-brand-600"></i> Same-Day Slots Available</span>
            <span class="flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-1.5 shadow-sm"><i class="fa-solid fa-percent text-brand-600"></i> 0% Payment Assist</span>
          </div>

          <div class="flex items-center justify-center gap-4 pt-3 lg:justify-start">
            <div class="flex items-center gap-3 rounded-xl border border-slate-200/80 bg-white px-4 py-2.5 shadow-sm">
              <div class="flex text-xs text-amber-400">
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
              </div>
              <div class="text-left">
                <div class="text-xs font-bold text-slate-900">{business.googleRating} / 5.0 on Google</div>
                <div class="text-[11px] text-slate-500">{business.googleReviewCount}+ Google reviews</div>
              </div>
            </div>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="relative rounded-2xl border border-slate-200 bg-white p-6 shadow-xl soft-shadow">
            <div class="mb-6 text-center">
              <span class="rounded-full border border-brand-100 bg-brand-50 px-2.5 py-1 text-xs font-semibold text-brand-600">Live Garage Availability</span>
              <h2 class="mt-2 text-xl font-bold text-slate-900">Check Your Vehicle & Book Online</h2>
              <p class="mt-1 text-sm text-slate-500">Instant DVLA MOT status lookup & booking calendar</p>
            </div>

            <div class="space-y-4">
              <div>
                <div class="relative flex items-center overflow-hidden rounded-xl border-2 border-slate-900 shadow-md">
                  <div class="uk-plate-blue flex flex-col items-center justify-center px-3 py-3.5 text-[10px] font-bold leading-tight select-none">
                    <i class="fa-solid fa-car-side mb-0.5 text-xs"></i>
                    <span>UK</span>
                  </div>
                  <input
                    type="text"
                    x-model="vrmInput"
                    @input="vrmFound = false; vrmLookupError = ''"
                    @keyup.enter="lookupVehicle()"
                    placeholder="FK68 MOT"
                    class="uk-plate w-full px-4 py-3 text-center text-2xl font-bold tracking-widest uppercase outline-none placeholder-slate-700/40 sm:text-3xl"
                  />
                </div>
              </div>

              <p class="text-xs text-slate-500">UK registration only. We’ll look up make, model and MOT status, then show live MOT slots.</p>

              <button
                type="button"
                @click="lookupVehicle()"
                :disabled="isSearchingVehicle"
                class="flex w-full items-center justify-center gap-2 rounded-xl bg-brand-600 px-6 py-3.5 text-sm font-semibold tracking-wide text-white shadow-md transition hover:bg-brand-700"
              >
                <span x-show="!isSearchingVehicle" class="flex items-center gap-2">
                  <i class="fa-solid fa-magnifying-glass"></i> Check Vehicle & View Available Slots
                </span>
                <span x-show="isSearchingVehicle" x-cloak class="flex items-center gap-2">
                  <i class="fa-solid fa-circle-notch animate-spin"></i> Fetching Vehicle Details...
                </span>
              </button>
            </div>

            <div x-show="vrmLookupError" x-cloak class="mt-4 rounded-xl border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-900" x-text="vrmLookupError"></div>

            <div x-show="vrmFound || vrmLookupError" x-cloak x-transition class="mt-5 border-t border-slate-100 pt-4">
              <div x-show="vrmFound" class="space-y-2 rounded-xl border border-slate-200 bg-slate-50 p-4 text-sm">
                <div class="flex items-center justify-between gap-3">
                  <span class="font-medium text-slate-500">Vehicle found:</span>
                  <span class="text-right text-sm font-bold text-slate-900" x-text="vehicleData.makeModel"></span>
                </div>
                <div class="flex items-center justify-between gap-3" x-show="vehicleData.colour">
                  <span class="font-medium text-slate-500">Colour:</span>
                  <span class="font-medium text-slate-700" x-text="vehicleData.colour"></span>
                </div>
                <div class="flex items-center justify-between gap-3">
                  <span class="font-medium text-slate-500">Engine / Fuel:</span>
                  <span class="font-medium text-slate-700" x-text="vehicleData.engineFuel"></span>
                </div>
                <div class="flex items-center justify-between gap-3">
                  <span class="font-medium text-slate-500">MOT status:</span>
                  <span
                    class="rounded-full px-2.5 py-0.5 text-right text-xs font-semibold"
                    :class="{
                      'bg-emerald-100 text-emerald-800': vehicleData.motTone === 'ok',
                      'bg-amber-100 text-amber-800': vehicleData.motTone === 'due',
                      'bg-rose-100 text-rose-800': vehicleData.motTone === 'expired',
                      'bg-slate-100 text-slate-700': vehicleData.motTone === 'unknown',
                    }"
                    x-text="vehicleData.motDue"
                  ></span>
                </div>
              </div>

              <button type="button" @click="openBookingModal()" class="mt-3 flex w-full items-center justify-center gap-2 rounded-xl bg-slate-900 py-3 text-xs font-semibold tracking-wide text-white transition hover:bg-slate-800">
                <span>Select Service & Pick Date/Time</span>
                <i class="fa-solid fa-arrow-right text-brand-500"></i>
              </button>
            </div>
          </div>
        </div>
      </div>

      {!hasHeroPhoto && (
        <p class="mt-8 rounded-lg border border-white/10 bg-black/30 px-3 py-2 text-[11px] text-slate-300 lg:max-w-xl">
          <i class="fa-solid fa-camera mr-1.5 text-brand-500"></i>
          Hero photo to capture: <span class="font-semibold text-white">{photos.heroWorkshop.label}</span>
          <span class="text-slate-400"> — drop</span>
          <code class="mx-1 font-mono text-brand-500">public/images/hero-workshop.jpg</code>
          <span class="text-slate-400">then refresh. It will replace this placeholder automatically.</span>
        </p>
      )}
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="container mx-auto px-4">
      <div class="mb-10 flex flex-col justify-between md:flex-row md:items-end">
        <div>
          <span class="rounded-full border border-brand-100 bg-brand-50 px-3 py-1 text-xs font-semibold tracking-wider text-brand-600 uppercase">Our Services</span>
          <h2 class="mt-2 text-2xl font-extrabold text-slate-900 sm:text-3xl">Transparent Workshop Pricing</h2>
        </div>
        <a href="/services" class="mt-3 flex items-center gap-1.5 text-sm font-semibold tracking-wide text-brand-600 hover:text-brand-700 md:mt-0">
          <span>View services & prices</span>
          <i class="fa-solid fa-arrow-right"></i>
        </a>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        <div class="hover-lift flex flex-col justify-between overflow-hidden rounded-2xl border border-slate-200/90 bg-white">
          <ImageSlot
            src={photos.serviceMot.src}
            label={photos.serviceMot.label}
            brief={photos.serviceMot.brief}
            alt="MOT tools board and emissions tester in the Bankside MOT bay"
            class="aspect-[16/10] w-full"
          />
          <div class="flex flex-1 flex-col justify-between p-6">
            <div class="space-y-3">
              <h3 class="text-xl font-bold text-slate-900"><a href="/mot-falkirk" class="hover:text-brand-700">Class 4 MOT</a></h3>
              <p class="text-sm leading-relaxed text-slate-600">Official DVSA inspection for cars, small vans and taxis. Most of our MOT customers book this test. If the car fails, phone the office to book a retest — that is not available online.</p>
              <div class="text-lg font-extrabold text-slate-900">£50</div>
            </div>
            <a href="/book" class="mt-6 w-full rounded-xl bg-slate-900 py-2.5 text-xs font-semibold text-white transition hover:bg-slate-800 text-center">Book MOT Test Slot</a>
          </div>
        </div>

        <div class="hover-lift flex flex-col justify-between overflow-hidden rounded-2xl border border-slate-200/90 bg-white">
          <ImageSlot
            src={photos.serviceServicing.src}
            label={photos.serviceServicing.label}
            brief={photos.serviceServicing.brief}
            class="aspect-[16/10] w-full"
          />
          <div class="flex flex-1 flex-col justify-between p-6">
            <div class="space-y-3">
              <h3 class="text-xl font-bold text-slate-900">Interim & Major Servicing</h3>
              <p class="text-sm leading-relaxed text-slate-600">Manufacturer-compliant routine servicing using OEM filters and oil to the manufacturer's recommendation. Prices vary by make and model.</p>
              <div class="text-lg font-extrabold text-slate-900">Interim from £175 • Major from £260</div>
            </div>
            <a href="tel:01324613007" class="mt-6 w-full rounded-xl bg-slate-900 py-2.5 text-xs font-semibold text-white transition hover:bg-slate-800 text-center">Call to book</a>
          </div>
        </div>

        <div class="hover-lift flex flex-col justify-between overflow-hidden rounded-2xl border border-slate-200/90 bg-white">
          <ImageSlot
            src={photos.brakeBefore.src}
            label={photos.brakeBefore.label}
            brief={photos.brakeBefore.brief}
            alt="Worn brake disc before pads and discs are replaced at Bankside MOT & Repair"
            class="aspect-[16/10] w-full"
          />
          <div class="flex flex-1 flex-col justify-between p-6">
            <div class="space-y-3">
              <h3 class="text-xl font-bold text-slate-900"><a href="/discs-and-pads" class="hover:text-brand-700">Diagnostics & Brakes</a></h3>
              <p class="text-sm leading-relaxed text-slate-600">Dealer-level diagnostic software for warning lights, ABS, airbag, DPF regeneration, and complete brake disc & pad replacements. Scan price depends on the vehicle and the job.</p>
              <div class="text-lg font-extrabold text-slate-900">Computer Scan: from £45</div>
            </div>
            <a href={`tel:${business.telephone}`} class="mt-6 w-full rounded-xl bg-slate-900 py-2.5 text-xs font-semibold text-white transition hover:bg-slate-800 text-center">Call to book</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden py-20">
    <div class="absolute inset-0">
      <ImageSlot
        src={photos.teamBand.src}
        label={photos.teamBand.label}
        brief={photos.teamBand.brief}
        alt="Bankside MOT & Repair technicians in the workshop"
        class="h-full w-full"
      />
    </div>
    <div class:list={['absolute inset-0', hasTeamBandPhoto ? 'bg-slate-950/80' : 'bg-slate-950/65']}></div>
    <div class="container relative z-10 mx-auto px-4">
      <div class="grid items-center gap-8 lg:grid-cols-12">
        <div class="space-y-3 lg:col-span-8">
          <span class="text-xs font-semibold tracking-wider text-brand-500 uppercase"><i class="fa-solid fa-user-gear mr-1"></i> The Bankside team</span>
          <h2 class="text-2xl font-extrabold text-white sm:text-3xl">Decades of local workshop experience</h2>
          <p class="max-w-2xl text-sm leading-relaxed text-slate-300 sm:text-base">
            From MOT testing to everyday repairs, the garage has decades on the tools between them — and a junior mechanic bringing fresh energy to the bays. Clear advice, upfront quotes, and work you can trust, without inflated dealer labour rates.
          </p>
          {!hasTeamBandPhoto && (
            <p class="text-[11px] text-slate-400">
              Photo to capture: <span class="font-semibold text-white">{photos.teamBand.label}</span>
              <code class="mx-1 font-mono text-brand-500">public/images/team-band.jpg</code>
            </p>
          )}
        </div>
        <div class="flex justify-start lg:col-span-4 lg:justify-end">
          <a href="/about" class="rounded-xl bg-brand-600 px-5 py-3 text-xs font-semibold text-white shadow-sm transition hover:bg-brand-700">
            Meet the team
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-slate-100 bg-slate-50 py-16">
    <div class="container mx-auto px-4">
      <div class="mb-10 flex flex-col justify-between gap-3 md:flex-row md:items-end">
        <div>
          <span class="rounded-full border border-brand-100 bg-brand-50 px-3 py-1 text-xs font-semibold tracking-wider text-brand-600 uppercase">From Google</span>
          <h2 class="mt-2 text-2xl font-extrabold text-slate-900 sm:text-3xl">What Falkirk drivers say</h2>
          <p class="mt-1 text-sm text-slate-600">Rated {business.googleRating} / 5 from {business.googleReviewCount}+ Google reviews.</p>
        </div>
        <a href={business.googleListingUrl} target="_blank" rel="noopener noreferrer" class="text-sm font-semibold text-brand-600 hover:text-brand-700">
          Read reviews on Google
        </a>
      </div>

      {reviews.some((review) => review.quote && review.name) ? (
        <div class="grid gap-6 md:grid-cols-3">
          {reviews.filter((review) => review.quote && review.name).map((review) => (
            <ReviewSlot prompt={review.prompt} quote={review.quote} name={review.name} place={review.place} />
          ))}
        </div>
      ) : (
        <div class="rounded-2xl border border-slate-200 bg-white p-6 sm:flex sm:items-center sm:justify-between">
          <p class="text-sm text-slate-600">See recent MOT and repair reviews on the Google listing, or leave one after your visit.</p>
          <div class="mt-4 flex flex-wrap gap-2 sm:mt-0">
            <a href={business.googleListingUrl} target="_blank" rel="noopener noreferrer" class="rounded-xl bg-slate-900 px-4 py-2.5 text-xs font-semibold text-white transition hover:bg-slate-800">Google reviews</a>
            <a href="/contact" class="rounded-xl border border-slate-200 px-4 py-2.5 text-xs font-semibold text-slate-900 transition hover:bg-slate-50">Find the workshop</a>
          </div>
        </div>
      )}
    </div>
  </section>
</Layout>
