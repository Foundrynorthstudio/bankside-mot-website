---
import Logo from './Logo.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));

const nav = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About Us & Team' },
  { href: '/services', label: 'Services & Pricing' },
  { href: '/finance', label: '0% Payment Assist' },
  { href: '/areas', label: 'Areas We Serve' },
  { href: '/contact', label: 'Contact' },
];

const mobileNav = [
  { href: '/', label: 'Home', icon: 'fa-house' },
  { href: '/about', label: 'About Us & Team', icon: 'fa-users' },
  { href: '/services', label: 'Services & Fixed Pricing', icon: 'fa-list-check' },
  { href: '/finance', label: '0% Payment Assist', icon: 'fa-percent' },
  { href: '/areas', label: 'Falkirk Service Areas', icon: 'fa-map-pin' },
  { href: '/contact', label: 'Contact & Directions', icon: 'fa-envelope' },
];
---

<!-- TOP ANNOUNCEMENT BAR -->
<div class="bg-slate-900 text-slate-300 text-xs font-medium py-2 px-4 border-b border-slate-800">
  <div class="container mx-auto flex justify-between items-center">
    <div class="flex items-center gap-3">
      <span class="bg-brand-600 text-white font-semibold text-[10px] px-2 py-0.5 rounded-full uppercase tracking-wider">Falkirk FK2</span>
      <span class="hidden sm:inline text-slate-300">Official DVSA Class 4 & Class 7 Approved MOT Testing Centre</span>
      <span class="sm:hidden text-slate-300">DVSA Approved MOT Station</span>
    </div>
    <div class="flex items-center space-x-5 text-xs font-semibold">
      <span class="hidden md:inline text-slate-400"><i class="fa-solid fa-clock text-brand-500 mr-1.5"></i> Mon–Fri: 8:30am – 5:00pm</span>
      <a href="tel:01324613007" class="text-white hover:text-brand-500 flex items-center gap-1.5 transition">
        <i class="fa-solid fa-phone text-brand-500"></i>
        <span>01324 613007</span>
      </a>
    </div>
  </div>
</div>

<!-- MAIN NAVIGATION BAR -->
<header class="sticky top-0 z-40 bg-white/90 backdrop-blur-md border-b border-slate-100 transition-all">
  <div class="container mx-auto px-4 py-2 flex items-center justify-between gap-4">
    <a href="/" class="shrink-0">
      <Logo class="h-14 sm:h-16 md:h-[4.75rem]" />
    </a>

    <nav class="hidden lg:flex items-center space-x-1 text-xs font-semibold text-slate-600">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            'px-3.5 py-2 rounded-lg transition',
            isActive(item.href)
              ? 'text-brand-600 bg-brand-50/80 font-bold'
              : 'hover:text-slate-900 hover:bg-slate-50',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="hidden sm:flex items-center gap-3">
      <button
        type="button"
        @click="openBookingModal()"
        class="px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-semibold text-xs tracking-wide shadow-sm transition flex items-center gap-2"
      >
        <i class="fa-regular fa-calendar-check text-brand-500"></i>
        <span>Book Online 24/7</span>
      </button>
    </div>

    <button
      type="button"
      @click="mobileMenuOpen = !mobileMenuOpen"
      class="lg:hidden p-2 rounded-lg text-slate-700 hover:bg-slate-100"
      aria-label="Toggle menu"
    >
      <i class="fa-solid" :class="mobileMenuOpen ? 'fa-xmark text-xl text-slate-900' : 'fa-bars text-xl'"></i>
    </button>
  </div>

  <div x-show="mobileMenuOpen" x-transition x-cloak class="lg:hidden bg-white border-b border-slate-200 px-4 pt-3 pb-6 space-y-2">
    {mobileNav.map((item) => (
      <a href={item.href} class="w-full text-left py-2.5 px-3 rounded-lg text-slate-700 font-semibold text-xs hover:bg-slate-50 block">
        <i class={`fa-solid ${item.icon} text-brand-600 mr-3 w-4`}></i> {item.label}
      </a>
    ))}

    <div class="pt-3 flex flex-col gap-2">
      <a href="tel:01324613007" class="w-full text-center py-2.5 rounded-xl bg-slate-100 text-slate-900 font-semibold text-xs border border-slate-200">
        <i class="fa-solid fa-phone mr-2 text-brand-600"></i> Call Garage (01324 613007)
      </a>
      <button
        type="button"
        @click="mobileMenuOpen = false; openBookingModal()"
        class="w-full text-center py-2.5 rounded-xl bg-brand-600 text-white font-semibold text-xs"
      >
        <i class="fa-solid fa-calendar-check mr-2"></i> Book Online
      </button>
    </div>
  </div>
</header>
