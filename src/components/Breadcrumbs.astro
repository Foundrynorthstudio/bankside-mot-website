---
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="border-b border-slate-100 bg-slate-50">
  <div class="container mx-auto px-4 py-3">
    <ol class="flex flex-wrap items-center gap-1.5 text-xs text-slate-500">
      {items.map((item, index) => (
        <li class="flex items-center gap-1.5">
          {index > 0 && <i class="fa-solid fa-chevron-right text-[9px] text-slate-400" aria-hidden="true"></i>}
          {item.href ? (
            <a href={item.href} class="font-medium hover:text-slate-800">{item.label}</a>
          ) : (
            <span class="font-semibold text-slate-700" aria-current="page">{item.label}</span>
          )}
        </li>
      ))}
    </ol>
  </div>
</nav>
